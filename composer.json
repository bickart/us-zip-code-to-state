{
    "name": "on2media/us-zip-code-to-state",
    "description": "Maps a US ZIP code to a state",
    "type": "library",
    "keywords": ["on2 media", "zip code", "state"],
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "autoload": {
        "psr-4": {
            "On2Media\\UsZipCodeToState\\": "src/"
        }
    },
    "scripts": {
        "phpcs-dry": "php-cs-fixer fix --verbose --allow-risky=yes --dry-run --diff",
        "phpcs-fix": "php-cs-fixer fix --verbose --allow-risky=yes"
    }
}
